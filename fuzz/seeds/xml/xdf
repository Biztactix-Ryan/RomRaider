    <flags>0x1</flags>
    <deftitle>Example</deftitle>
    <BASEOFFSET offset="0" subtract="0"/>
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x8000" regionflags="0x0" name="Binary File"/>
  </XDFHEADER>
  <XDFTABLE uniqueid="0x1A2B" flags="0x30">
