#!/bin/sh
# AppImage entry point (packaging/appimage/build.sh): run the bundled
# romraider-cli with the caller's arguments. The AppImage runtime sets APPDIR
# to the mounted (or extracted) AppDir; fall back to this file's directory
# when AppRun is run from an AppDir by hand.
HERE=$(dirname "$(readlink -f "$0")")
exec "${APPDIR:-$HERE}/usr/bin/romraider-cli" "$@"
